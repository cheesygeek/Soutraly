PORT=3000
NODE_ENV=development
DB_PATH=./data/soutraly.db

# Webhook Twilio WhatsApp Sandbox (voir README pour la configuration complete)
TWILIO_AUTH_TOKEN=
# Necessaire pour telecharger les photos/PDF envoyes par les utilisateurs (KYC)
TWILIO_ACCOUNT_SID=
# Numero WhatsApp expediteur pour les messages sortants (rappels avant echeance).
# Format E.164 sans le prefixe "whatsapp:", ex: +14155238886 pour le sandbox.
TWILIO_WHATSAPP_FROM=
# URL publique exacte de ce serveur (ex: https://soutraly-production.up.railway.app).
# Sur Railway, laisser vide pour utiliser automatiquement RAILWAY_PUBLIC_DOMAIN.
PUBLIC_BASE_URL=

# Protege /admin.html et /api/admin/* (documents KYC reels desormais accessibles
# depuis cette page) - obligatoire, sinon personne ne peut se connecter.
ADMIN_USERNAME=
ADMIN_PASSWORD=
